 "categories": [
  {
   "code": "C01",
   "name": "仓位与集中",
   "desc": "单票上限、家数、满仓禁令、集中与分散的行为规则"
  },
  {
   "code": "C02",
   "name": "杠杆与本金",
   "desc": "不融资、不加杠杆、本金不归零、不碰会被强平的工具"
  },
  {
   "code": "C03",
   "name": "现金与生存层",
   "desc": "应急金、现金线、几年内要用的钱不入市、生活费备足"
  },
  {
   "code": "C04",
   "name": "买入闸门",
   "desc": "下单前必答的问题、必写的东西、写不出就不买"
  },
  {
   "code": "C05",
   "name": "估值与安全边际",
   "desc": "估值区间、先估价值再看价格、精确目标价存疑"
  },
  {
   "code": "C06",
   "name": "卖出与认错",
   "desc": "止损、认错价、证伪即卖、理由消失就卖、翻倍收本"
  },
  {
   "code": "C07",
   "name": "加仓与减仓",
   "desc": "分批、追高禁令、冷却期、高估分批减、空仓测试"
  },
  {
   "code": "C08",
   "name": "频率与节律",
   "desc": "交易笔数上限、看盘次数、复核周期、体检频率"
  },
  {
   "code": "C09",
   "name": "信息与研究",
   "desc": "信息源清理、独立证据、一手渠道、对手盘台词、研究笔记"
  },
  {
   "code": "C10",
   "name": "心力与身体",
   "desc": "失眠即超限、情绪日不交易、睡眠运动家人、晒收益暂停"
  },
  {
   "code": "C11",
   "name": "复盘与记录",
   "desc": "交易日志、归因、错因归层、年度审计、只与自己比"
  },
  {
   "code": "C12",
   "name": "周期与逆向",
   "desc": "钟摆判断、热度判断、人声鼎沸只减不加、这次不一样即停手"
  },
  {
   "code": "C13",
   "name": "分散与相关性",
   "desc": "同一因子重新分散、股债现金层次、再平衡"
  },
  {
   "code": "C14",
   "name": "时间与持有期",
   "desc": "最短服役期、不设涨到多少的时间表、慢策略年限"
  },
  {
   "code": "C15",
   "name": "费用与税",
   "desc": "费率超本金比例砍交易、成本纪律"
  },
  {
   "code": "C16",
   "name": "衍生品与做空",
   "desc": "准入闸门、不祥之器、能不用就不用"
  },
  {
   "code": "C17",
   "name": "制度与分工",
   "desc": "两人搭伙一买一卖、全职条件、修订一年一次、盘中不改规则"
  },
  {
   "code": "C18",
   "name": "学习与修炼",
   "desc": "失败案例精读、读年报、书单次序、能力圈边界"
  }
